   "source": [
    "from langchain_community.document_loaders import ArxivLoader\n",
    "\n",
    "loader = ArxivLoader(\n",
    "  query = \"Chain of Thought\",\n",
    "  load_max_docs=2,\n",
    "  load_all_available_meta = True # 메타데이터 전체 로드 여부\n",
    ")\n",
    "\n",
    "docs = loader.load()\n",
    "docs"
   ]
  }
