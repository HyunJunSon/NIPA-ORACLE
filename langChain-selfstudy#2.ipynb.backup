   "source": [
    "from langchain_community.document_loaders import UnstructuredPowerPointLoader\n",
    "\n",
    "loader = UnstructuredPowerPointLoader(\"data/LangChain_ lecture_ppt.pptx\")\n",
    "docs = loader.load()\n",
    "print(len(docs))"
   ]
  },
